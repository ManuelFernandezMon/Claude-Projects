{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/extract.ts": {
      "maxDuration": 120
    },
    "api/generate.ts": {
      "maxDuration": 120
    },
    "api/convert.ts": {
      "maxDuration": 120
    },
    "api/photos.ts": {
      "maxDuration": 30
    },
    "api/video-start.ts": {
      "maxDuration": 60
    },
    "api/video-find.ts": {
      "maxDuration": 60
    },
    "api/video-extract.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

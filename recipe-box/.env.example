# Copy to .env.local for `npm run dev`. On Vercel, set the same names under Project -> Settings -> Environment Variables.
# Never prefix these with VITE_ (that would ship them to the browser).

# Required for the AI pages (Ask AI, Import link): a long random string you invent.
# The app asks for it once per device so strangers can't spend your quota.
RECIPE_IMPORT_PASSCODE=

# Pick ONE provider (set its key). Free option: Gemini.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Video upload (Import a recipe -> Choose video) always uses Gemini, so GEMINI_API_KEY is needed for it
# even when AI_PROVIDER=anthropic.

# Optional free backup for text-only requests (caption, web page, Ask AI, measurements) when Gemini is busy or out of quota.
# Free key at openrouter.ai/keys. Free models share capacity, may log prompts, and change often; video and screenshots never use it.
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,openrouter/free   # tried in order

# Optional. Without it: Anthropic if ANTHROPIC_API_KEY is set, otherwise Gemini.
# AI_PROVIDER=gemini        # or: anthropic

# Optional model overrides
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite   # default: ordered fallback list
# RECIPE_IMPORT_MODEL=claude-opus-5-5    # Anthropic model (default shown)

# Optional cloud accounts (Supabase). Both values are public by design; see "Cloud accounts" in the README.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=
# Optional: signed-in accounts with these emails use the AI without the passcode (needs SUPABASE_* above).
# AI_ALLOWED_EMAILS=me@gmail.com, mom@gmail.com

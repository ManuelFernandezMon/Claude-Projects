# Copy to .env.local for `npm run dev`. On Vercel, set the same names under Project -> Settings -> Environment Variables.
# Never prefix these with VITE_ (that would ship them to the browser).

# Required for "Import from link"
ANTHROPIC_API_KEY=
# A long random string you invent; the app asks for it once per device so strangers can't spend your API credits
RECIPE_IMPORT_PASSCODE=

# Optional: override the model (default claude-opus-5-5)
# RECIPE_IMPORT_MODEL=

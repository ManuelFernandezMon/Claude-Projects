# Copy to .env.local for `npm run dev`. On Vercel, set the same names under Project -> Settings -> Environment Variables.
# Never prefix these with VITE_ (that would ship them to the browser).

# Required for the AI pages (Ask AI, Import link): a long random string you invent.
# The app asks for it once per device so strangers can't spend your quota.
RECIPE_IMPORT_PASSCODE=

# Pick ONE provider (set its key). Free option: Gemini.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional. Without it: Anthropic if ANTHROPIC_API_KEY is set, otherwise Gemini.
# AI_PROVIDER=gemini        # or: anthropic

# Optional model overrides
# GEMINI_MODEL=gemini-3.8-flash          # default; gemini-3.5-flash-lite is the faster/cheaper option
# RECIPE_IMPORT_MODEL=claude-opus-5-5    # Anthropic model (default shown)

{
  "name": "ui-styles-2026",
  "private": true,
  "version": "1.0.0",
  "description": "Single-page showcase of 20 web UI styles. The site itself has no build step; these are verification tools only.",
  "scripts": {
    "serve": "http-server . -p 4173 -c-1 --silent",
    "lint:css": "stylelint \"css/*.css\"",
    "lint:html": "html-validate index.html",
    "format:check": "prettier --check index.html css js scripts",
    "verify:shots": "node scripts/verify/shots.mjs",
    "verify:axe": "node scripts/verify/axe.mjs",
    "verify:keyboard": "node scripts/verify/keyboard.mjs",
    "verify:console": "node scripts/verify/console.mjs",
    "verify:overflow": "node scripts/verify/overflow.mjs",
    "verify:contrast": "node scripts/verify/contrast.mjs",
    "verify:recipes": "node scripts/verify/recipes.mjs",
    "verify:preferences": "node scripts/verify/preferences.mjs",
    "verify:nojs": "node scripts/verify/nojs.mjs",
    "verify:lighthouse": "scripts/verify/lighthouse.sh",
    "verify": "npm run lint:html && npm run lint:css && npm run format:check && npm run verify:console && npm run verify:axe && npm run verify:keyboard && npm run verify:overflow && npm run verify:recipes && npm run verify:preferences && npm run verify:nojs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "html-validate": "^11.0.0",
    "http-server": "^14.1.1",
    "lighthouse": "^13.0.0",
    "playwright": "^1.56.1",
    "prettier": "^3.3.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
